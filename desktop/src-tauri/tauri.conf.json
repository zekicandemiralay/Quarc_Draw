{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarc Draw",
  "version": "1.3.1",
  "identifier": "com.quarc.draw",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Quarc",
    "shortDescription": "Layered raster + vector drawing studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quarc Draw",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "backgroundColor": "#121417"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
