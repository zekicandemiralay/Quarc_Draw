{
  "name": "quarc-draw",
  "version": "1.1.0",
  "private": true,
  "description": "Quarc Draw — a professional layered raster + vector drawing app by QuarcNet.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "server": "cd ../backend && node src/index.mjs --dev-auth",
    "icons": "node scripts/gen-icons.mjs",
    "perf": "node tests/e2e/perf-fps.mjs"
  },
  "dependencies": {
    "ag-psd": "^34.2.3",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/zekicandemiralay/Quarc_Draw.git"
  },
  "engines": {
    "node": ">=20"
  }
}
