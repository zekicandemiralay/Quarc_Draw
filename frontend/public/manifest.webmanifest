{
  "name": "Quarc Draw",
  "short_name": "Quarc Draw",
  "description": "Professional layered raster + vector drawing studio.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121417",
  "theme_color": "#121417",
  "categories": ["graphics", "productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "/", "accept": { "application/vnd.quarc.draw+zip": [".qdraw"], "image/png": [".png"], "image/jpeg": [".jpg", ".jpeg"], "image/svg+xml": [".svg"], "image/vnd.adobe.photoshop": [".psd"] } }
  ],
  "shortcuts": [
    { "name": "New drawing", "url": "/?new=drawing" }
  ]
}
