node_modules/
frontend/dist/
.env
.env.*
!.env.example
backup_*/
backups/
*.log
.DS_Store
Thumbs.db

# local data of the dev server
backend/data/

# browser test output
frontend/tests/e2e/out/

# Android signing — never commit these
mobile/*.keystore
mobile/keystore-password.txt

# Tauri / Capacitor build output
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/dist/*
!desktop/dist/index.html
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/app/release.keystore
mobile/android/local.properties
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/app/src/main/assets/capacitor.plugins.json
mobile/android/capacitor-cordova-android-plugins/build/
mobile/www/*
!mobile/www/index.html

# Generated by tauri-build from the app manifest in build.rs (the Quarc Store sign-in commands)
desktop/src-tauri/permissions/autogenerated/

# the painting made by frontend/scripts/paint-artwork.mjs: the full-size files stay on disk, the small web copy is frontend/public/art/
art/.previews/
art/*.png
art/*.qdraw
art/*.webp
